# Copiar estas variables a las Environment Variables del servicio en Render
# (Dashboard de Render -> servicio -> Environment). No se commitea el .env real.

# Credenciales de la aplicacion creada en developers.mercadolibre.com.ar
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://TU-SERVICIO.onrender.com/callback

# Conexion a la base de datos Postgres (Render -> base de datos -> Internal Database URL)
DATABASE_URL=

# Login inicial (solo se usa UNA vez, la primera vez que arranca el server,
# para crear tu primer usuario dentro de la tabla "usuarios" y que no quedes
# afuera de tu propia app). Despues de ese primer arranque, los logins se
# manejan desde Configuracion -> Usuarios, uno por persona, y estas dos
# variables ya no se usan para nada.
APP_LOGIN_USER=
APP_LOGIN_PASS=

# Clave para firmar las sesiones (cualquier texto largo al azar)
SESSION_SECRET=
