<%
// Arma el link de una cabecera ordenable, preservando el resto de los filtros activos.
function linkOrden(campo, label) {
  const nuevaDir = (sort === campo && dir === 'asc') ? 'desc' : 'asc';
  const params = new URLSearchParams({
    estado: filtro, costo: costoFiltro, stock: stockFiltro, q, sort: campo, dir: nuevaDir
  });
  const flecha = sort === campo ? (dir === 'asc' ? ' ▲' : ' ▼') : '';
  return `<a href="/publicaciones?${params.toString()}" class="th-link">${label}${flecha}</a>`;
}

// Traducción de estado/sub_status. MercadoLibre tiene más estados que
// activa/pausada; los que no reconocemos los mostramos tal cual los manda ML.
const ESTADOS = {
  active: { label: 'Activa', clase: 'badge-activo' },
  paused: { label: 'Pausada', clase: 'badge-pausado' },
  under_review: { label: 'En revisión', clase: 'badge-stock-bajo' },
  closed: { label: 'Cerrada', clase: 'badge-pausado' },
  inactive: { label: 'Inactiva', clase: 'badge-stock-bajo' },
};
function estadoInfo(estado) {
  return ESTADOS[estado] || { label: estado, clase: 'badge-pausado' };
}
function esInactivaPorPoliticas(it) {
  return it.estado !== 'active' && it.estado !== 'paused';
}
const SUB_ESTADOS = {
  out_of_stock: 'sin stock',
  deleted: 'eliminada',
  suspended: 'suspendida',
  expired: 'vencida',
  payment_required: 'pago pendiente',
  price_mismatch: 'precio no coincide',
  forbidden: 'no permitida',
};
function traducirSubEstado(code) {
  return SUB_ESTADOS[code] || code;
}
// Experimental: traducción del estado de "mejor oferta" / Buy Box. Solo
// aplica a publicaciones de catálogo; para el resto va a venir vacío.
const PRECIO_A_GANAR = {
  winning: { label: 'Ganando', clase: 'badge-activo' },
  sharing_first_place: { label: 'Compartiendo 1er lugar', clase: 'badge-stock-bajo' },
};
function precioEstadoInfo(status) {
  return PRECIO_A_GANAR[status] || { label: status, clase: 'badge-stock-bajo' };
}
%>
<%- include('partials/head', { title: 'Publicaciones - SymL', active: 'publicaciones' }) %>

  <h1>Publicaciones (<%= total %>)</h1>
  <p><a href="/nueva-publicacion" class="link-btn">+ Nueva publicación</a></p>
  <% if (typeof creada !== 'undefined' && creada) { %>
    <p class="muted" style="color: var(--verde); font-weight: 700;">✔ Publicación creada en MercadoLibre (ID <%= creada %>). Puede tardar unos segundos en aparecer en la lista de abajo.</p>
  <% } %>
  <% if (typeof errorAccion !== 'undefined' && errorAccion) { %>
    <p class="error"><%= errorAccion %></p>
  <% } %>
  <p class="muted">
    Comisión y envío son estimados por MercadoLibre antes de la venta. Impuestos es el
    % que cargaste en <a href="/configuracion">Configuración</a>. Conviene ir ajustando
    estos valores con tus ventas reales cada tanto. El ícono ⚠ al lado del nombre indica
    que MercadoLibre considera que esa publicación podría mejorarse (completar más datos,
    fotos, etc.) — es un indicador de ellos, no algo que calculemos nosotros. La columna
    "Precio vs. competencia" es experimental y solo va a traer datos en publicaciones de
    catálogo (donde varios vendedores compiten por la misma ficha) — en el resto va a
    quedar vacía, y es normal.
  </p>

  <form method="GET" action="/publicaciones" class="filtros-form">
    <input type="hidden" name="sort" value="<%= sort %>" />
    <input type="hidden" name="dir" value="<%= dir %>" />

    <div class="tabs">
      <a href="/publicaciones?estado=todas&costo=<%= costoFiltro %>&stock=<%= stockFiltro %>&q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>" class="<%= filtro === 'todas' ? 'active' : '' %>">Todas</a>
      <a href="/publicaciones?estado=activas&costo=<%= costoFiltro %>&stock=<%= stockFiltro %>&q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>" class="<%= filtro === 'activas' ? 'active' : '' %>">Activas</a>
      <a href="/publicaciones?estado=pausadas&costo=<%= costoFiltro %>&stock=<%= stockFiltro %>&q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>" class="<%= filtro === 'pausadas' ? 'active' : '' %>">Pausadas</a>
      <a href="/publicaciones?estado=inactivas&costo=<%= costoFiltro %>&stock=<%= stockFiltro %>&q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>" class="<%= filtro === 'inactivas' ? 'active' : '' %>">Inactivas / en revisión</a>
    </div>

    <input type="hidden" name="estado" value="<%= filtro %>" />

    <div class="filtros-row">
      <input type="text" name="q" value="<%= q %>" placeholder="Buscar por nombre..." class="input-busqueda" />

      <label class="check-label">
        <input type="checkbox" name="costo" value="sin" onchange="this.form.submit()" <%= costoFiltro === 'sin' ? 'checked' : '' %> />
        Sin costo cargado
      </label>

      <label class="check-label">
        <input type="checkbox" name="stock" value="bajo" onchange="this.form.submit()" <%= stockFiltro === 'bajo' ? 'checked' : '' %> />
        Stock bajo (≤ <%= stockBajoUmbral %>)
      </label>

      <button type="submit" class="link-btn">Buscar</button>
    </div>
  </form>

  <div class="tabla-wrap">
  <table class="tabla">
    <thead>
      <tr>
        <th><%- linkOrden('titulo', 'Producto') %></th>
        <th>Estado</th>
        <th><%- linkOrden('precio', 'Precio') %></th>
        <th>Costo</th>
        <th>Comisión ML</th>
        <th>Envío</th>
        <th>Impuestos</th>
        <th><%- linkOrden('margen', 'Margen neto') %></th>
        <th><%- linkOrden('stock', 'Stock') %></th>
        <th title="Experimental: solo aplica a publicaciones de catálogo">Precio vs. competencia</th>
        <th>Tipo</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody>
      <% items.forEach(function(it) { %>
        <tr>
          <td class="prod-cell">
            <img src="<%= it.thumbnail %>" alt="" class="thumb" />
            <a href="<%= it.permalink %>" target="_blank" rel="noopener"><%= it.titulo %></a>
            <% if (it.health != null && it.health < 0.6) { %>
              <span title="MercadoLibre sugiere mejorar esta publicación">⚠</span>
            <% } %>
            <% if (it.stock <= stockBajoUmbral) { %>
              <span class="badge badge-stock-bajo">stock bajo</span>
            <% } %>
          </td>
          <td>
            <span class="badge <%= estadoInfo(it.estado).clase %>">
              <%= estadoInfo(it.estado).label %>
            </span>
            <% if (it.subEstado && it.subEstado.length > 0) { %>
              <div class="muted" style="margin-top: 2px;">
                <%= it.subEstado.map(traducirSubEstado).join(', ') %>
              </div>
            <% } %>
            <% if (it.estado === 'active' || it.estado === 'paused') { %>
              <form method="POST" action="/productos/<%= it.id %>/estado" class="inline-form">
                <input type="hidden" name="estado" value="<%= it.estado === 'active' ? 'paused' : 'active' %>" />
                <button type="submit" class="link-btn">
                  <%= it.estado === 'active' ? 'Pausar' : 'Activar' %>
                </button>
              </form>
            <% } else { %>
              <div class="muted" style="margin-top: 4px;">Resolvé esto desde MercadoLibre</div>
            <% } %>
          </td>
          <td>
            $<%= it.precio %>
            <form method="POST" action="/productos/<%= it.id %>/precio" class="inline-form" style="margin-top: 6px;">
              <input type="number" step="0.01" min="0" name="precio" value="<%= it.precio %>" class="input-chico" style="width: 85px;" />
              <button type="submit" class="link-btn">Cambiar precio</button>
            </form>
            <% if (it.costo != null) { %>
              <form
                method="POST"
                action="/productos/<%= it.id %>/precio"
                class="inline-form margen-objetivo-form"
                style="margin-top: 6px;"
                data-costo="<%= it.costo %>"
                data-comision="<%= it.comisionML || 0 %>"
                data-envio="<%= it.envioCost || 0 %>"
                data-impuestos="<%= it.impuestosPct || 0 %>"
              >
                <input
                  type="number"
                  step="0.1"
                  name="margenObjetivoPct"
                  placeholder="% marg."
                  class="input-chico margen-objetivo-input"
                  style="width: 70px;"
                  title="Margen objetivo (% sobre el costo): calcula el precio para llegar a ese margen"
                />
                <input type="hidden" name="precio" class="precio-sugerido-hidden" />
                <button type="submit" class="link-btn precio-sugerido-btn" disabled>Aplicar</button>
                <div class="muted precio-sugerido-preview"></div>
              </form>
            <% } %>
          </td>
          <td>
            <form method="POST" action="/productos/<%= it.id %>/costo" class="inline-form">
              <input type="number" step="0.01" name="costo" value="<%= it.costo != null ? it.costo : '' %>" placeholder="costo" class="input-chico" />
              <button type="submit" class="link-btn">Guardar</button>
            </form>
          </td>
          <td>
            <% if (it.comisionML != null) { %>
              $<%= it.comisionML.toFixed(2) %>
            <% } else { %>
              <span class="muted">sin datos</span>
            <% } %>
          </td>
          <td>
            <% if (!it.envioGratis) { %>
              <span class="muted">a cargo del comprador</span>
            <% } else if (it.envioCost != null) { %>
              $<%= it.envioCost.toFixed(2) %>
              <span class="muted">(gratis, estimado)</span>
            <% } else { %>
              <span class="muted">envío gratis, sin datos</span>
            <% } %>
          </td>
          <td>
            <% if (it.impuestosPct > 0) { %>
              $<%= it.impuestoMonto.toFixed(2) %>
              <span class="muted">(<%= it.impuestosPct %>%)</span>
            <% } else { %>
              <span class="muted">—</span>
            <% } %>
          </td>
          <td>
            <% if (it.margen != null) { %>
              $<%= it.margen.toFixed(2) %>
              <% if (it.margenPct != null) { %>
                <span class="muted">(<%= it.margenPct.toFixed(0) %>%)</span>
              <% } %>
            <% } else { %>
              <span class="muted">cargá el costo</span>
            <% } %>
          </td>
          <td>
            <form method="POST" action="/productos/<%= it.id %>/stock" class="inline-form">
              <input type="number" name="stock" value="<%= it.stock %>" class="input-chico" />
              <button type="submit" class="link-btn">Guardar</button>
            </form>
          </td>
          <td>
            <% if (it.precioAGanar) { %>
              <span class="badge <%= precioEstadoInfo(it.precioAGanar.status).clase %>">
                <%= precioEstadoInfo(it.precioAGanar.status).label %>
              </span>
              <% if (it.precioAGanar.precioParaGanar != null) { %>
                <div class="muted" style="margin-top: 2px;">Para ganar: $<%= it.precioAGanar.precioParaGanar %></div>
              <% } %>
            <% } else { %>
              <span class="muted">—</span>
            <% } %>
          </td>
          <td>
            <span class="badge <%= it.tipo === 'drop' ? 'badge-drop' : 'badge-activo' %>">
              <%= it.tipo === 'drop' ? 'Drop' : 'Propio' %>
            </span>
            <form method="POST" action="/productos/<%= it.id %>/tipo" class="inline-form" style="margin-top: 4px;">
              <select name="tipo" class="input-chico" style="width: auto;">
                <option value="propio" <%= it.tipo !== 'drop' ? 'selected' : '' %>>Propio</option>
                <option value="drop" <%= it.tipo === 'drop' ? 'selected' : '' %>>Drop</option>
              </select>
              <input type="text" name="proveedor" value="<%= it.proveedor || '' %>" placeholder="proveedor" class="input-chico" style="width: 90px;" />
              <button type="submit" class="link-btn">Guardar</button>
            </form>
          </td>
          <td>
            <a href="/publicaciones/<%= it.id %>" class="link-btn">Ver detalle</a>
            <div style="margin-top: 4px;">
              <a href="<%= it.permalink %>" target="_blank" rel="noopener" class="link-btn">Ver en ML</a>
            </div>
          </td>
        </tr>
      <% }) %>
      <% if (items.length === 0) { %>
        <tr><td colspan="12" class="muted">No hay publicaciones que coincidan con los filtros.</td></tr>
      <% } %>
    </tbody>
  </table>
  </div>

  <script>
  (function () {
    // Para cada fila: a partir de un margen objetivo (% sobre el costo), calcula
    // el precio de venta necesario, usando los mismos datos (costo, comisión ML,
    // envío, impuestos) que ya tenemos cargados del lado del servidor para esa
    // publicación puntual — es la misma fórmula que usa el Agente de mejoras.
    function calcularPrecioSugerido(costo, comision, envio, impuestosPct, margenObjetivoPct) {
      var divisor = 1 - impuestosPct / 100;
      if (divisor <= 0) return null;
      var objetivo = costo * (margenObjetivoPct / 100);
      return Math.ceil((objetivo + costo + comision + envio) / divisor);
    }

    document.querySelectorAll('.margen-objetivo-form').forEach(function (form) {
      var costo = parseFloat(form.dataset.costo) || 0;
      var comision = parseFloat(form.dataset.comision) || 0;
      var envio = parseFloat(form.dataset.envio) || 0;
      var impuestosPct = parseFloat(form.dataset.impuestos) || 0;
      var input = form.querySelector('.margen-objetivo-input');
      var hidden = form.querySelector('.precio-sugerido-hidden');
      var boton = form.querySelector('.precio-sugerido-btn');
      var preview = form.querySelector('.precio-sugerido-preview');

      function actualizar() {
        var pct = parseFloat(input.value);
        if (isNaN(pct)) {
          hidden.value = '';
          boton.disabled = true;
          preview.textContent = '';
          return;
        }
        var sugerido = calcularPrecioSugerido(costo, comision, envio, impuestosPct, pct);
        if (sugerido == null) {
          hidden.value = '';
          boton.disabled = true;
          preview.textContent = 'Impuestos ≥ 100%: no hay precio posible.';
          return;
        }
        hidden.value = sugerido;
        boton.disabled = false;
        boton.textContent = 'Aplicar: $' + sugerido;
        preview.textContent = '';
      }

      input.addEventListener('input', actualizar);
    });
  })();
  </script>

<%- include('partials/foot') %>
