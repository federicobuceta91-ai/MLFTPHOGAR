<%- include('partials/head', { title: 'Nueva publicación - SymL', active: 'nueva-publicacion' }) %>

  <h1>Nueva publicación</h1>
  <p class="muted">
    Se va a crear con la misma categoría, condición, forma de envío y atributos que
    <strong><%= template.title %></strong>. Si MercadoLibre necesita algún dato
    adicional por el rubro del producto (o rechaza algo), te lo muestro acá abajo
    tal cual lo devuelve ML para que lo podamos ajustar.
  </p>
  <% if (template.pictures && template.pictures.length > 0) { %>
    <p class="muted">
      Esta plantilla tiene <%= template.pictures.length %> foto(s) cargada(s). Si
      dejás "Fotos" vacío más abajo, se reusan esas mismas fotos para la publicación nueva.
    </p>
  <% } %>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>

  <div class="card" style="max-width: 560px;">
    <form method="POST" action="/nueva-publicacion/<%= template.id %>">
      <label>Título</label><br/>
      <input type="text" name="titulo" value="<%= valores ? valores.titulo : template.title %>" required maxlength="60" style="width: 100%; padding: 6px;" /><br/>

      <label style="display:block; margin-top: 14px;">Precio</label>
      <input type="number" step="0.01" min="0" name="precio" value="<%= valores ? valores.precio : template.price %>" required style="width: 100%; padding: 6px;" /><br/>

      <label style="display:block; margin-top: 14px;">Stock</label>
      <input type="number" min="0" name="stock" value="<%= valores ? valores.stock : template.available_quantity %>" required style="width: 100%; padding: 6px;" /><br/>

      <label style="display:block; margin-top: 14px;">Fotos (opcional, una URL de imagen por línea)</label>
      <p class="muted" style="margin: 4px 0;">Dejalo en blanco para reusar las mismas fotos de la plantilla.</p>
      <textarea name="fotos" rows="3" placeholder="https://..." style="width: 100%; padding: 6px;"><%= valores ? valores.fotos : '' %></textarea>

      <label style="display:block; margin-top: 14px;">Descripción</label>
      <textarea name="descripcion" rows="5" style="width: 100%; padding: 6px;"><%= valores ? valores.descripcion : descripcion %></textarea>

      <label style="display:block; margin-top: 14px;">Costo (solo para calcular margen acá adentro, no se manda a MercadoLibre)</label>
      <input type="number" step="0.01" min="0" name="costo" value="<%= valores ? (valores.costo || '') : '' %>" style="width: 100%; padding: 6px;" />

      <label style="display:block; margin-top: 14px;">Tipo</label>
      <div style="display:flex; gap: 16px; margin-top: 6px;">
        <label style="display:flex; align-items:center; gap:6px; font-weight: normal;">
          <input type="radio" name="tipo" value="propio" <%= (!valores || valores.tipo !== 'drop') ? 'checked' : '' %> /> Propio
        </label>
        <label style="display:flex; align-items:center; gap:6px; font-weight: normal;">
          <input type="radio" name="tipo" value="drop" <%= (valores && valores.tipo === 'drop') ? 'checked' : '' %> /> Drop
        </label>
      </div>
      <input type="text" name="proveedor" placeholder="Proveedor (si es Drop)" value="<%= valores ? (valores.proveedor || '') : '' %>" style="width: 100%; padding: 6px; margin-top: 8px;" />

      <button type="submit" style="margin-top: 20px;">Publicar en MercadoLibre</button>
    </form>
  </div>

<%- include('partials/foot') %>
