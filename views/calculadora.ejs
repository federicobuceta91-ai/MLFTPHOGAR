<%- include('partials/head', { title: 'Calculadora - SymL', active: 'calculadora' }) %>

  <h1>Calculadora de rentabilidad</h1>
  <p class="muted">
    Para estimar antes de publicar (o para jugar con números): cargá el costo y una
    comisión/impuestos aproximados y probá las dos opciones de abajo. Todo se calcula
    acá mismo, en tu navegador — no guarda nada ni toca ninguna publicación real. Si
    querés el margen de una publicación que ya tenés en MercadoLibre, mejor usá
    <a href="/publicaciones">Publicaciones</a>, donde ya usamos la comisión y el envío
    reales que informa MercadoLibre para esa publicación en particular.
  </p>

  <div class="card calc-card">
    <h2 style="font-size: 16px; margin-top: 0;">Datos base</h2>
    <div class="calc-grid">
      <div>
        <label for="calcCosto">Costo del producto ($)</label>
        <input type="number" step="0.01" min="0" id="calcCosto" placeholder="ej: 500" />
      </div>
      <div>
        <label for="calcComision">Comisión de MercadoLibre (% del precio de venta)</label>
        <input type="number" step="0.1" min="0" max="100" id="calcComision" placeholder="ej: 13" />
      </div>
      <div>
        <label for="calcEnvio">Costo de envío a tu cargo ($, si ofrecés envío gratis)</label>
        <input type="number" step="0.01" min="0" id="calcEnvio" value="0" />
      </div>
      <div>
        <label for="calcImpuestos">Impuestos (% del precio de venta)</label>
        <input type="number" step="0.1" min="0" max="100" id="calcImpuestos" value="<%= impuestosPctDefault %>" />
      </div>
    </div>
    <p class="muted" style="margin-top: 10px;">
      La comisión de MercadoLibre varía según la categoría y el tipo de publicación —
      revisala en el simulador de MercadoLibre o en una publicación parecida a la tuya
      si no la sabés de memoria.
    </p>

    <div style="margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--borde);">
      <label for="calcLogistica">Costo fijo por unidad vendida (productos menores a $33.000)</label>
      <select id="calcLogistica">
        <option value="flex">Envíos Flex / acuerdo con el comprador / retiro en domicilio (se calcula solo, por tramo de precio)</option>
        <option value="full">Envíos Full / correo / colecta / puntos de despacho (varía según peso y medidas — cargalo vos)</option>
      </select>
      <div id="calcFijoManualWrap" style="display: none; margin-top: 10px;">
        <label for="calcFijoManual">Costo fijo por unidad vendida ($)</label>
        <input type="number" step="0.01" min="0" id="calcFijoManual" value="0" />
      </div>
      <p class="muted" style="margin-top: 10px;">
        Desde noviembre de 2026, en productos de menos de $33.000 MercadoLibre cobra,
        además de la comisión de arriba, un costo fijo por cada unidad vendida: con
        Envíos Flex/acuerdo/retiro es un monto fijo según el precio ($1.330 hasta
        $14.999 · $2.740 de $15.000 a $23.999 · $3.320 de $24.000 a $32.999 · no se
        cobra desde $33.000); con Full/correo/colecta/puntos de despacho se calcula
        según el peso y las medidas del producto, así que ese número lo tenés que
        cargar vos (lo ves en el simulador de costos de MercadoLibre). Si vendés kits,
        este costo se cobra una sola vez por kit, no por unidad adentro del kit. Estos
        montos los puede cambiar MercadoLibre en cualquier momento — si ves que no
        coinciden con lo que te cobran de verdad, avisanos para actualizarlos.
      </p>
    </div>
  </div>

  <div class="cards-grid" style="margin-top: 16px;">
    <div class="card calc-card">
      <h2 style="font-size: 16px; margin-top: 0;">Opción 1: ya tengo un precio, ¿qué margen me queda?</h2>
      <label for="calcPrecio">Precio de venta ($)</label>
      <input type="number" step="0.01" min="0" id="calcPrecio" placeholder="ej: 900" />
      <div class="calc-resultado">
        <div class="stat-label">Margen neto</div>
        <div class="stat-value" id="resMargen">—</div>
        <p class="muted" id="resMargenDetalle">Completá costo y precio de venta.</p>
      </div>
    </div>

    <div class="card calc-card">
      <h2 style="font-size: 16px; margin-top: 0;">Opción 2: quiero un margen, ¿qué precio pongo?</h2>
      <label for="calcMargenObjetivo">Margen objetivo (% sobre el costo)</label>
      <input type="number" step="0.1" min="0" id="calcMargenObjetivo" placeholder="ej: 30" />
      <div class="calc-resultado">
        <div class="stat-label">Precio sugerido</div>
        <div class="stat-value" id="resPrecio">—</div>
        <p class="muted" id="resPrecioDetalle">Completá costo y margen objetivo.</p>
      </div>
    </div>
  </div>

<script>
(function () {
  function num(id) {
    var el = document.getElementById(id);
    if (!el) return null;
    var v = parseFloat(el.value);
    return isNaN(v) ? null : v;
  }
  function fmt(n) {
    var signo = n < 0 ? '-' : '';
    return signo + '$' + Math.abs(n).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  // Costo fijo por unidad vendida que cobra MercadoLibre además de la comisión,
  // solo en productos de menos de $33.000 (ver nota en la página, fuente:
  // vendedores.mercadolibre.com.ar/landing/costos-de-venta, vigente a noviembre
  // de 2026). Con Envíos Flex/acuerdo/retiro es un monto fijo por tramo de
  // precio; con Full/correo/colecta depende del peso y las medidas del
  // producto, así que ahí lo carga el usuario a mano.
  var TRAMOS_FIJO_FLEX = [
    { min: 0, max: 14999, fijo: 1330 },
    { min: 15000, max: 23999, fijo: 2740 },
    { min: 24000, max: 32999, fijo: 3320 },
    { min: 33000, max: Infinity, fijo: 0 },
  ];

  function costoFijoFlexPorPrecio(precio) {
    for (var i = 0; i < TRAMOS_FIJO_FLEX.length; i++) {
      var t = TRAMOS_FIJO_FLEX[i];
      if (precio >= t.min && precio <= t.max) return t.fijo;
    }
    return 0;
  }

  // Para "margen objetivo -> precio" con Flex, el costo fijo depende del
  // precio que todavía no conocemos (depende del tramo en el que caiga). Como
  // los tramos son pocos y están ordenados, probamos cada uno asumiendo su
  // costo fijo y nos quedamos con el primero que da un precio consistente con
  // ese mismo tramo.
  function precioConFijoFlex(costo, comisionPct, envio, impuestosPct, margenObjetivoPct, divisor) {
    var objetivo = costo * (margenObjetivoPct / 100);
    for (var i = 0; i < TRAMOS_FIJO_FLEX.length; i++) {
      var t = TRAMOS_FIJO_FLEX[i];
      var candidato = (objetivo + costo + envio + t.fijo) / divisor;
      if (candidato >= t.min && candidato <= t.max) {
        return { precio: candidato, fijo: t.fijo };
      }
    }
    // No debería pasar, pero por las dudas: sin cargo fijo.
    return { precio: (objetivo + costo + envio) / divisor, fijo: 0 };
  }

  function recalcular() {
    var costo = num('calcCosto');
    var comisionPct = num('calcComision') || 0;
    var envio = num('calcEnvio') || 0;
    var impuestosPct = num('calcImpuestos') || 0;
    var logistica = document.getElementById('calcLogistica').value;
    var fijoManual = num('calcFijoManual') || 0;

    document.getElementById('calcFijoManualWrap').style.display = logistica === 'full' ? '' : 'none';

    // Opción 1: a partir de un precio de venta, calcula el margen neto.
    var precio = num('calcPrecio');
    var resMargen = document.getElementById('resMargen');
    var resMargenDetalle = document.getElementById('resMargenDetalle');
    if (costo != null && precio != null) {
      var comisionMonto = (precio * comisionPct) / 100;
      var impuestoMonto = (precio * impuestosPct) / 100;
      var costoFijo = logistica === 'flex' ? costoFijoFlexPorPrecio(precio) : fijoManual;
      var margen = precio - costo - comisionMonto - envio - impuestoMonto - costoFijo;
      var margenPct = costo > 0 ? (margen / costo) * 100 : null;
      resMargen.textContent = fmt(margen);
      resMargen.style.color = margen < 0 ? 'var(--rojo)' : 'var(--verde)';
      resMargenDetalle.textContent =
        'Comisión estimada: ' + fmt(comisionMonto) + ' · Impuesto: ' + fmt(impuestoMonto) +
        ' · Costo fijo por venta: ' + fmt(costoFijo) +
        (margenPct != null ? ' · Margen: ' + margenPct.toFixed(1) + '% sobre el costo' : '');
    } else {
      resMargen.textContent = '—';
      resMargen.style.color = '';
      resMargenDetalle.textContent = 'Completá costo y precio de venta.';
    }

    // Opción 2: a partir de un margen objetivo (% sobre el costo), calcula el
    // precio de venta necesario. Como acá la comisión se ingresa como % del
    // precio (no como monto fijo), entra en el divisor junto con impuestos.
    var margenObjetivoPct = num('calcMargenObjetivo');
    var resPrecio = document.getElementById('resPrecio');
    var resPrecioDetalle = document.getElementById('resPrecioDetalle');
    if (costo != null && margenObjetivoPct != null) {
      var divisor = 1 - comisionPct / 100 - impuestosPct / 100;
      if (divisor > 0) {
        var resultado =
          logistica === 'flex'
            ? precioConFijoFlex(costo, comisionPct, envio, impuestosPct, margenObjetivoPct, divisor)
            : { precio: (costo * (margenObjetivoPct / 100) + costo + envio + fijoManual) / divisor, fijo: fijoManual };
        resPrecio.textContent = fmt(resultado.precio);
        resPrecio.style.color = '';
        resPrecioDetalle.textContent =
          'Con ' + comisionPct + '% de comisión, ' + impuestosPct + '% de impuestos y ' + fmt(resultado.fijo) +
          ' de costo fijo por venta, ese precio te deja ' + margenObjetivoPct + '% de margen sobre el costo.';
      } else {
        resPrecio.textContent = '—';
        resPrecioDetalle.textContent = 'La comisión más los impuestos suman 100% o más: no hay precio posible.';
      }
    } else {
      resPrecio.textContent = '—';
      resPrecioDetalle.textContent = 'Completá costo y margen objetivo.';
    }
  }

  ['calcCosto', 'calcComision', 'calcEnvio', 'calcImpuestos', 'calcPrecio', 'calcMargenObjetivo', 'calcFijoManual'].forEach(function (id) {
    document.getElementById(id).addEventListener('input', recalcular);
  });
  document.getElementById('calcLogistica').addEventListener('change', recalcular);
  recalcular();
})();
</script>

<%- include('partials/foot') %>
