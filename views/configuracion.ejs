<%- include('partials/head', { title: 'Configuración - SymL', active: 'configuracion' }) %>

  <h1>Configuración</h1>

  <div class="card" style="max-width: 420px;">
    <% if (guardado) { %>
      <p class="muted" style="color: var(--verde); font-weight: 700;">Guardado ✔</p>
    <% } %>
    <form method="POST" action="/configuracion">
      <label>Porcentaje de impuestos a descontar del margen</label>
      <p class="muted">
        Se aplica sobre el precio de venta de cada producto. Cargá el % que te indique
        tu contador según tu categoría (Monotributo, percepciones de IIBB, etc.) — esto
        es una estimación tuya, no un cálculo oficial de MercadoLibre ni de AFIP.
      </p>
      <input type="number" step="0.01" min="0" max="100" name="impuestos_pct" value="<%= config.impuestos_pct %>" />
      <button type="submit" style="margin-top: 16px;">Guardar</button>
    </form>
  </div>

  <p class="muted" style="margin-top: 20px;">
    Nota: la comisión de MercadoLibre y el costo de envío que ves en "Publicaciones"
    son estimaciones que trae la API de MercadoLibre antes de la venta. Conviene
    ajustarlas de tanto en tanto comparándolas con tus ventas reales (liquidaciones),
    porque pueden variar según el método de pago del comprador y otras condiciones.
  </p>

  <div class="card" style="max-width: 420px; margin-top: 24px;">
    <% if (splGuardado) { %>
      <p class="muted" style="color: var(--verde); font-weight: 700;">Guardado ✔</p>
    <% } %>
    <% if (splError) { %>
      <p class="error"><%= splError %></p>
    <% } %>
    <form method="POST" action="/configuracion/spl-login">
      <label>Usuario para imprimir etiquetas (Panel SPL / depósito)</label>
      <p class="muted">
        Un usuario y clave aparte de tu login normal, para la persona que solo
        necesita entrar a <a href="/spl" target="_blank" rel="noopener">/spl</a> a ver
        los pedidos listos para facturar y bajar/imprimir el remito.
        <% if (spl.configurado) { %>
          Hoy está configurado con el usuario <strong><%= spl.usuario %></strong>.
        <% } else { %>
          Todavía no lo configuraste — el Panel SPL no va a dejar entrar a nadie hasta que lo hagas.
        <% } %>
      </p>
      <input type="text" name="usuario" placeholder="usuario" value="<%= spl.usuario || '' %>" required />
      <input
        type="password"
        name="clave"
        placeholder="<%= spl.configurado ? 'nueva clave (dejar en blanco para no cambiarla)' : 'clave' %>"
        <%= spl.configurado ? '' : 'required' %>
        style="margin-top: 10px;"
      />
      <input
        type="password"
        name="clave2"
        placeholder="repetir clave"
        <%= spl.configurado ? '' : 'required' %>
        style="margin-top: 10px;"
      />
      <button type="submit" style="margin-top: 16px;">Guardar</button>
    </form>
  </div>

  <div class="card" style="max-width: 640px; margin-top: 24px;">
    <h2 style="font-size: 16px; margin-top: 0;">Usuarios</h2>
    <p class="muted">
      Cada persona entra con su propio usuario y clave — ya no se comparte un solo
      login. Por ahora todos los usuarios tienen el mismo nivel de acceso (no hay
      roles ni permisos diferenciados todavía).
    </p>

    <% if (usuarioCreado) { %>
      <p class="muted" style="color: var(--verde); font-weight: 700;">Guardado ✔</p>
    <% } %>
    <% if (usuarioError) { %>
      <p class="error"><%= usuarioError %></p>
    <% } %>

    <div class="tabla-wrap">
      <table class="tabla">
        <thead>
          <tr>
            <th>Email / usuario</th>
            <th>Nombre</th>
            <th>Estado</th>
            <th>Creado</th>
            <th>Cambiar clave</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% usuarios.forEach(function (u) { %>
            <tr>
              <td>
                <%= u.email %>
                <% if (String(u.id) === String(usuarioActualId)) { %>
                  <span class="muted">(vos)</span>
                <% } %>
              </td>
              <td><%= u.nombre || '—' %></td>
              <td>
                <span class="badge <%= u.activo ? 'badge-activo' : 'badge-pausado' %>">
                  <%= u.activo ? 'Activo' : 'Desactivado' %>
                </span>
              </td>
              <td class="muted"><%= new Date(u.creado_en).toLocaleDateString('es-AR') %></td>
              <td>
                <form method="POST" action="/configuracion/usuarios/<%= u.id %>/clave" style="display: flex; gap: 6px;">
                  <input type="password" name="clave" placeholder="clave nueva" style="width: 110px;" required />
                  <input type="password" name="clave2" placeholder="repetir" style="width: 100px;" required />
                  <button type="submit" class="link-btn">Cambiar</button>
                </form>
              </td>
              <td>
                <form method="POST" action="/configuracion/usuarios/<%= u.id %>/activo">
                  <input type="hidden" name="activo" value="<%= u.activo ? '0' : '1' %>" />
                  <button type="submit" class="link-btn">
                    <%= u.activo ? 'Desactivar' : 'Activar' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <h3 style="font-size: 14px; margin-top: 20px;">Crear usuario nuevo</h3>
    <form method="POST" action="/configuracion/usuarios">
      <label for="usuarioEmail">Email o usuario</label>
      <input type="text" id="usuarioEmail" name="email" placeholder="ej: morena@gmail.com" required />
      <label for="usuarioNombre" style="margin-top: 10px;">Nombre (opcional, para identificarla en la lista)</label>
      <input type="text" id="usuarioNombre" name="nombre" placeholder="ej: Morena" />
      <div style="display: flex; gap: 10px; margin-top: 10px;">
        <div style="flex: 1;">
          <label for="usuarioClave">Clave</label>
          <input type="password" id="usuarioClave" name="clave" required />
        </div>
        <div style="flex: 1;">
          <label for="usuarioClave2">Repetir clave</label>
          <input type="password" id="usuarioClave2" name="clave2" required />
        </div>
      </div>
      <button type="submit" style="margin-top: 16px;">Crear usuario</button>
    </form>
  </div>

<%- include('partials/foot') %>
