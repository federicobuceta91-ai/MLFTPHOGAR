<%
const ESTADOS = {
  active: { label: 'Activa', clase: 'badge-activo' },
  paused: { label: 'Pausada', clase: 'badge-pausado' },
  under_review: { label: 'En revisión', clase: 'badge-stock-bajo' },
  closed: { label: 'Cerrada', clase: 'badge-pausado' },
  inactive: { label: 'Inactiva', clase: 'badge-stock-bajo' },
};
function estadoInfo(estado) {
  return ESTADOS[estado] || { label: estado, clase: 'badge-pausado' };
}
const PRECIO_A_GANAR = {
  winning: { label: 'Ganando', clase: 'badge-activo' },
  sharing_first_place: { label: 'Compartiendo 1er lugar', clase: 'badge-stock-bajo' },
};
function precioEstadoInfo(status) {
  return PRECIO_A_GANAR[status] || { label: status, clase: 'badge-stock-bajo' };
}
function formatoSemana(fechaInicio) {
  return new Date(fechaInicio).toLocaleDateString('es-AR', { day: '2-digit', month: '2-digit' });
}
const maxVentaSemana = Math.max(1, ...ventasPorSemana.map((b) => b.cantidad));
%>
<%- include('partials/head', { title: 'Detalle de publicación - SymL', active: 'publicaciones' }) %>

  <p><a href="/publicaciones" class="link-btn">&larr; Volver a Publicaciones</a></p>

  <% if (errorAccion) { %>
    <p class="error"><%= errorAccion %></p>
  <% } %>

  <div class="card" style="display: flex; gap: 16px; align-items: flex-start;">
    <img src="<%= item.thumbnail %>" alt="" class="thumb" style="width: 70px; height: 70px;" />
    <div>
      <h1 style="margin: 0 0 6px 0; font-size: 18px;">
        <%= item.titulo %>
        <% if (item.health != null && item.health < 0.6) { %>
          <span title="MercadoLibre sugiere mejorar esta publicación">⚠</span>
        <% } %>
      </h1>
      <span class="badge <%= estadoInfo(item.estado).clase %>"><%= estadoInfo(item.estado).label %></span>
      <span class="badge <%= item.tipo === 'drop' ? 'badge-drop' : 'badge-activo' %>">
        <%= item.tipo === 'drop' ? 'Drop' : 'Propio' %>
      </span>
      <% if (item.stock <= stockBajoUmbral) { %>
        <span class="badge badge-stock-bajo">stock bajo (<%= item.stock %>)</span>
      <% } %>
      <p class="muted" style="margin-top: 8px;">
        <a href="<%= item.permalink %>" target="_blank" rel="noopener">Ver en MercadoLibre</a>
      </p>
    </div>
  </div>

  <div class="cards-grid" style="margin-top: 16px;">

    <div class="card">
      <h2 style="font-size: 16px; margin-top: 0;">Cambiar precio</h2>
      <p class="muted">Precio actual: <strong>$<%= item.precio %></strong></p>

      <form method="POST" action="/productos/<%= item.id %>/precio" class="inline-form">
        <input type="number" step="0.01" min="0" name="precio" value="<%= item.precio %>" class="input-chico" style="width: 100px;" />
        <button type="submit" class="link-btn">Cambiar precio</button>
      </form>

      <% if (item.costo != null) { %>
        <form
          method="POST"
          action="/productos/<%= item.id %>/precio"
          class="inline-form margen-objetivo-form"
          style="margin-top: 10px;"
          data-costo="<%= item.costo %>"
          data-comision="<%= item.comisionML || 0 %>"
          data-envio="<%= item.envioCost || 0 %>"
          data-impuestos="<%= item.impuestosPct || 0 %>"
        >
          <input
            type="number"
            step="0.1"
            name="margenObjetivoPct"
            placeholder="% margen objetivo"
            class="input-chico margen-objetivo-input"
            style="width: 110px;"
            title="Margen objetivo (% sobre el costo): calcula el precio para llegar a ese margen"
          />
          <input type="hidden" name="precio" class="precio-sugerido-hidden" />
          <button type="submit" class="link-btn precio-sugerido-btn" disabled>Aplicar</button>
          <div class="muted precio-sugerido-preview"></div>
        </form>
      <% } else { %>
        <p class="muted" style="margin-top: 10px;">Cargá el costo (al lado) para poder calcular un precio por margen objetivo.</p>
      <% } %>
    </div>

    <div class="card">
      <h2 style="font-size: 16px; margin-top: 0;">Desglose de costos y margen</h2>
      <form method="POST" action="/productos/<%= item.id %>/costo" class="inline-form">
        <input type="number" step="0.01" name="costo" value="<%= item.costo != null ? item.costo : '' %>" placeholder="costo" class="input-chico" />
        <button type="submit" class="link-btn">Guardar costo</button>
      </form>

      <table class="tabla" style="margin-top: 12px;">
        <tbody>
          <tr>
            <td>Precio de venta</td>
            <td>$<%= item.precio %></td>
          </tr>
          <tr>
            <td>Costo</td>
            <td><%= item.costo != null ? '$' + item.costo : 'sin cargar' %></td>
          </tr>
          <tr>
            <td>Comisión ML</td>
            <td><%= item.comisionML != null ? '$' + item.comisionML.toFixed(2) : 'sin datos' %></td>
          </tr>
          <tr>
            <td>Envío</td>
            <td>
              <% if (!item.envioGratis) { %>
                a cargo del comprador
              <% } else if (item.envioCost != null) { %>
                $<%= item.envioCost.toFixed(2) %> <span class="muted">(gratis, estimado)</span>
              <% } else { %>
                envío gratis, sin datos
              <% } %>
            </td>
          </tr>
          <tr>
            <td>Impuestos (<%= item.impuestosPct %>%)</td>
            <td><%= item.impuestosPct > 0 ? '$' + item.impuestoMonto.toFixed(2) : '—' %></td>
          </tr>
          <tr style="font-weight: 700;">
            <td>Margen neto</td>
            <td>
              <% if (item.margen != null) { %>
                $<%= item.margen.toFixed(2) %>
                <% if (item.margenPct != null) { %>
                  <span class="muted" style="font-weight: 400;">(<%= item.margenPct.toFixed(0) %>% sobre el costo)</span>
                <% } %>
              <% } else { %>
                <span class="muted" style="font-weight: 400;">cargá el costo para calcularlo</span>
              <% } %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2 style="font-size: 16px; margin-top: 0;">
        Visitas y conversión (últimos 30 días)
        <span class="badge badge-stock-bajo">Experimental</span>
      </h2>
      <table class="tabla">
        <tbody>
          <tr><td>Visitas</td><td><%= visitas != null ? visitas : '—' %></td></tr>
          <tr><td>Unidades vendidas</td><td><%= ventas30.cantidad %></td></tr>
          <tr><td>Monto vendido</td><td>$<%= Math.round(ventas30.monto).toLocaleString('es-AR') %></td></tr>
          <tr><td>Conversión</td><td><%= conversion != null ? conversion.toFixed(1) + '%' : '—' %></td></tr>
        </tbody>
      </table>
      <p class="muted" style="margin-top: 8px;">
        No pudimos confirmar en vivo el endpoint de visitas de MercadoLibre durante el
        desarrollo — si ves "—" en vez de un número, puede ser que el endpoint no sea
        el correcto.
      </p>
    </div>

    <div class="card">
      <h2 style="font-size: 16px; margin-top: 0;">Competencia</h2>
      <% if (item.precioAGanar) { %>
        <p>
          <span class="badge <%= precioEstadoInfo(item.precioAGanar.status).clase %>">
            <%= precioEstadoInfo(item.precioAGanar.status).label %>
          </span>
          <% if (item.precioAGanar.precioParaGanar != null) { %>
            <span class="muted">— para ganar: $<%= item.precioAGanar.precioParaGanar %></span>
          <% } %>
        </p>
      <% } else { %>
        <p class="muted">Sin dato de Buy Box (normal si esta publicación no participa de una ficha de catálogo compartida).</p>
      <% } %>

      <% if (precioCategoria) { %>
        <p class="muted" style="margin-top: 10px;">
          Precio promedio de la categoría (primeras <%= precioCategoria.cantidad %> publicaciones del buscador público):
          <strong>$<%= Math.round(precioCategoria.promedio).toLocaleString('es-AR') %></strong>,
          mínimo <strong>$<%= Math.round(precioCategoria.minimo).toLocaleString('es-AR') %></strong>.
        </p>
      <% } else { %>
        <p class="muted" style="margin-top: 10px;">Sin dato de precio de categoría.</p>
      <% } %>
      <span class="badge badge-stock-bajo">Experimental</span>
    </div>

  </div>

  <h2 style="font-size: 16px; margin-top: 24px;">Historial de ventas (últimas <%= ventasPorSemana.length %> semanas)</h2>
  <% if (ventasPorSemana.every((b) => b.cantidad === 0)) { %>
    <p class="muted">Todavía no hay ventas de este producto en las últimas <%= ventasPorSemana.length %> semanas.</p>
  <% } else { %>
    <div class="chart-barras">
      <% ventasPorSemana.forEach(function(b) { %>
        <div class="barra-col">
          <div class="barra-valor"><%= b.cantidad %>u</div>
          <div class="barra" style="height: <%= Math.max(2, Math.round((b.cantidad / maxVentaSemana) * 100)) %>%;"></div>
          <div class="barra-label"><%= formatoSemana(b.inicio) %></div>
        </div>
      <% }) %>
    </div>
  <% } %>

<script>
(function () {
  function calcularPrecioSugerido(costo, comision, envio, impuestosPct, margenObjetivoPct) {
    var divisor = 1 - impuestosPct / 100;
    if (divisor <= 0) return null;
    var objetivo = costo * (margenObjetivoPct / 100);
    return Math.ceil((objetivo + costo + comision + envio) / divisor);
  }

  document.querySelectorAll('.margen-objetivo-form').forEach(function (form) {
    var costo = parseFloat(form.dataset.costo) || 0;
    var comision = parseFloat(form.dataset.comision) || 0;
    var envio = parseFloat(form.dataset.envio) || 0;
    var impuestosPct = parseFloat(form.dataset.impuestos) || 0;
    var input = form.querySelector('.margen-objetivo-input');
    var hidden = form.querySelector('.precio-sugerido-hidden');
    var boton = form.querySelector('.precio-sugerido-btn');
    var preview = form.querySelector('.precio-sugerido-preview');

    function actualizar() {
      var pct = parseFloat(input.value);
      if (isNaN(pct)) {
        hidden.value = '';
        boton.disabled = true;
        preview.textContent = '';
        return;
      }
      var sugerido = calcularPrecioSugerido(costo, comision, envio, impuestosPct, pct);
      if (sugerido == null) {
        hidden.value = '';
        boton.disabled = true;
        preview.textContent = 'Impuestos ≥ 100%: no hay precio posible.';
        return;
      }
      hidden.value = sugerido;
      boton.disabled = false;
      boton.textContent = 'Aplicar: $' + sugerido;
      preview.textContent = '';
    }

    input.addEventListener('input', actualizar);
  });
})();
</script>

<%- include('partials/foot') %>
